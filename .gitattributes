# Force LF line endings for all Linux scripts and configs
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.gptk text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Binary files & zipapps (never alter line endings!)
*.png binary -text -eol
*.jpg binary -text -eol
*.jpeg binary -text -eol
*.bmp binary -text -eol
*.ico binary -text -eol
*.ttf binary -text -eol
*.so binary -text -eol
*.so.* binary -text -eol
*.7z binary -text -eol
*.7z.* binary -text -eol
*.zip binary -text -eol
*.tar binary -text -eol
*.gz binary -text -eol
*.db binary -text -eol
*.elf binary -text -eol
